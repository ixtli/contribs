# The dataset (tools/contrib-dataset/contrib.db) IS committed — it powers the
# Netlify build — so it is intentionally NOT ignored here.

# Transient SQLite sidecar files
*.db-journal
*.db-wal

# Regenerable exports / logs
out/
sync.log

# Python bytecode
__pycache__/
*.pyc

# Never commit credentials
*.token
.env
